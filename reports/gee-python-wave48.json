  "implementation": {
    "syntax": "Image.fastDistanceTransform: missing/null optionals use neighborhood256, pixels, squared_euclidean. Integral numeric neighborhood1..4096, squared_euclidean/manhattan/chebyshev; malformed arguments and unsupported units reject.",
    "local_policy": "Finite unmasked nonzero values are targets. Every observed center, including a masked center, receives a finite per-band Int32 distance capped at N*N for squared Euclidean or N otherwise. No-target output equals this cap. These cutoff, masked-target, multiband and dtype policies are not verified Google equivalence.",
    "precision": "Source precision is retained through eligible first/last selection, clipping and masking before target detection. Output integers<=2^24 allow direct sqrt/threshold use in existing Float32 callbacks. Explicit Float32 source rounding and prior arithmetic keep their existing behavior.",
    "halo": "Bounded cropped Boolean target fragments use checked global coordinates and exact observed center/time membership. Multi-hop reads preserve sparse SpatialKey/SpaceTimeKey sets. Group validation precedes window allocation; duplicate markers and malformed/oversized groups reject.",
    "numeric": "Exact separable squared Euclidean transform uses integer parabola crossovers; Manhattan and Chebyshev use directional scans. All are linear in window cells, with Long intermediates and public saturation before Int conversion.",
    "graph": "Proven finite common source grid, full source bounds before export ROI/resampling, single-band v adapter metadata and six driver pushdown blockers. Names/properties/time and existing50000-step/500-node/1MB boundaries preserved.",
    "budgets": {
      "wire_ascii_bytes": 1024,
      "compiler_steps": 50000,
      "graph_nodes": 500,
      "public_json_bytes": 1000000,
      "source_keys": 100000,
      "working_cells_per_tile": 10000000,
      "working_cells_total": 100000000,
      "work_per_tile": 100000000,
      "work_total": 1000000000,
      "transform_work_per_window_cell": 64,
      "scope": "Logical cell allocations include source/conversion/targets/output, window, fragment copies, Long output plus envelope/column scratch. Own-kernel work includes scans/copies/assembly/crop/candidate probes. Upstream evaluation, IO, Spark retries and stable-source enforcement are separate. Specification acceptance does not mean every layout fits."
    },
    "stable_source_assumption": "The repeated bounded census and later lazy evaluation must produce the same unique keys from an immutable snapshot. Nondeterministic duplicate source emissions can exceed aggregate shuffle estimates before duplicate-center rejection; this is an unverified distributed-resource boundary, not a tested production guarantee."
  },
